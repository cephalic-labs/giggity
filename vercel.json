{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "experimentalServices": {
        "web": {
            "entrypoint": "apps/web",
            "routePrefix": "/",
            "framework": "nextjs"
        },
        "backend": {
            "entrypoint": "backend/app/main.py",
            "routePrefix": "/_/backend",
            "framework": "fastapi",
            "includeFiles": [
                "backend/ml/zone_training_data.csv"
            ]
        }
    }
}
